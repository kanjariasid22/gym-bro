# GymBro environment (copy to .env and fill in)

# LLM
GROQ_API_KEY=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Paths (local defaults; override on EC2 for EBS mounts)
DATABASE_URL=sqlite:///./data/gymbro.db
MEMORY_DATA_DIR=./data/memory

# API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (optional; default is http://localhost:8000)
# VITE_API_BASE=http://localhost:8000
